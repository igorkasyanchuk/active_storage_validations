{
  "permissions": {
    "allow": [
      "Bash(bundle exec rake spec:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(cat AGENTS.md)",
      "Bash(cat .cursor/rules/*)",
      "Bash(cat .cursor/skills/*)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git push --force:*)"
    ]
  }
}
