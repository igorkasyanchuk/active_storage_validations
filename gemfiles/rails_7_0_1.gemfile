source 'https://rubygems.org'

%w[activejob activemodel activestorage activesupport].each { |rails_subcomponent| gem rails_subcomponent, '~> 7.0.1' }

# nokogiri < 1.18 requires ruby < 3.4.dev, which breaks CI on Ruby 3.4 / 4.0
gem 'nokogiri', '>= 1.18'

# Rails 7.0's sqlite3 adapter is pinned to ~> 1.4
gem 'sqlite3', '~> 1.7'

gemspec :path => '../'
