source 'https://rubygems.org'

# Floor at the latest patch so a lock refresh cannot fall back to an older release,
# e.g. 7.2.3 to keep minitest 6 / connection_pool 3 (7.2.4 caps both below those majors)
%w[activejob activemodel activestorage activesupport].each { |rails_subcomponent| gem rails_subcomponent, '~> 7.2.0', '>= 7.2.4' }

# sqlite3 < 2.9 requires ruby < 3.5.dev, which breaks CI on Ruby 4.0
gem 'sqlite3', '>= 2.9'

gemspec :path => '../'
