source 'https://rubygems.org'

# Floor at the latest patch so a lock refresh cannot fall back to an older release
%w[activejob activemodel activestorage activesupport].each { |rails_subcomponent| gem rails_subcomponent, '~> 8.0.0', '>= 8.0.5.2' }

gemspec :path => '../'

# sqlite3 < 2.9 requires ruby < 3.5.dev, which breaks CI on Ruby 4.0
gem 'sqlite3', '>= 2.9'
# nokogiri < 1.18 requires ruby < 3.4.dev, which breaks CI on Ruby 3.4 / 4.0
gem 'nokogiri', '>= 1.18'
gem 'ffi', '>= 1.17.1'
